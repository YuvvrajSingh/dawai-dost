# Server-only keys. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
VAPI_PRIVATE_KEY=

# Meta WhatsApp pilot: server-only. Use a persistent-volume Node server for the bot.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set to the supported Graph API version selected in your Meta dashboard.
META_GRAPH_API_VERSION=
# Absolute persistent path, e.g. C:/private/dawai-dost/whatsapp.sqlite
WHATSAPP_DB_PATH=
WHATSAPP_SUPPORT_CONTACT=
WHATSAPP_PRIVACY_URL=
WHATSAPP_BOT_ENABLED=false
# Optional: enables actual nearby map listings. Without it, bot provides locator links.
GOOGLE_PLACES_API_KEY=

# Jan Aushadhi stock + restock alerts
# Shared PIN for the "For Kendra staff" screen. Dev default is 1234; in production
# staff updates are off until this is set.
KENDRA_STAFF_PIN=
# Demo stock fills in quantities Kendra staff haven't entered (labelled "Demo stock"
# in the app). Set to 0 to show only staff-entered stock.
STOCK_DEMO=1
# Web push keys. Leave empty in dev (a pair is generated into data/runtime/).
# For production generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: protects POST /api/alerts/check for a cron job
CRON_SECRET=

# Public, non-secret config
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# "mock" (default) uses labelled illustrative data. "api" calls the /api routes.
NEXT_PUBLIC_DATA_MODE=mock
